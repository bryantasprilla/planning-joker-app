rules_version = '2';

// One document per table. Everything lives on that document so the TTL policy on
// `expiresAt` removes a whole session in one delete (TTL does not cascade to subcollections).
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {

      function signedIn() {
        return request.auth != null;
      }

      function me() {
        return request.auth.uid;
      }

      function isOpen() {
        return resource.data.expiresAt > request.time && resource.data.get('closed', false) == false;
      }

      function isDealer() {
        return resource.data.dealerId == me();
      }

      function validName(name) {
        return name is string && name.size() >= 1 && name.size() <= 40;
      }

      function validLabel(label) {
        return label is string && label.size() <= 200;
      }

      function validCard(value) {
        return value in ['0', '1', '2', '3', '5', '8', '13', '21', 'fold'];
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Joining or renaming: only your own roster entry changes.
      function selfRosterWrite() {
        let before = resource.data.participants;
        let after = request.resource.data.participants;
        let diff = after.diff(before);
        return diff.affectedKeys().hasOnly([me()])
          && diff.removedKeys().size() == 0
          && validSeat(after[me()]);
      }

      // Every seat is rendered for every player, so a malformed one would break the table for all.
      function validSeat(seat) {
        return seat.keys().hasOnly(['name', 'joinedAt'])
          && validName(seat.name)
          && seat.joinedAt is timestamp;
      }

      // Playing, changing or pulling back your own card while the round is open.
      function selfVoteWrite() {
        let before = resource.data.currentRound;
        let after = request.resource.data.currentRound;
        return before.status == 'voting'
          && me() in resource.data.participants
          && after.diff(before).affectedKeys().hasOnly(['votes'])
          && after.votes.diff(before.votes).affectedKeys().hasOnly([me()])
          && (!(me() in after.votes) || validCard(after.votes[me()]));
      }

      // The dealer runs the round: reveal, re-vote, next round, ticket label.
      // Votes can only be kept as they are or cleared, never written on someone's behalf.
      function dealerWrite() {
        let round = request.resource.data.currentRound;
        return round.keys().hasOnly(['round', 'ticketLabel', 'status', 'votes'])
          && round.status in ['voting', 'revealed']
          && validLabel(round.ticketLabel)
          && round.round is int
          && (round.votes == resource.data.currentRound.votes || round.votes.size() == 0);
      }

      // Open a table by its code (the invite link), but never list or query tables:
      // that would hand anyone every table's names, tickets and votes.
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'sessionId', 'dealerId', 'createdAt', 'expiresAt',
             'participants', 'currentRound', 'roundHistory'])
        && request.resource.data.sessionId == sessionId
        && request.resource.data.dealerId == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && request.resource.data.participants.keys().hasOnly([me()])
        && validSeat(request.resource.data.participants[me()])
        && request.resource.data.currentRound.status == 'voting'
        && request.resource.data.currentRound.votes.size() == 0
        && validLabel(request.resource.data.currentRound.ticketLabel)
        && request.resource.data.roundHistory.size() == 0;

      // The dealer hands the button to someone already seated.
      function passButton() {
        return changedKeys().hasOnly(['dealerId'])
          && request.resource.data.dealerId in resource.data.participants;
      }

      function closeTable() {
        return changedKeys().hasOnly(['closed']) && request.resource.data.closed == true;
      }

      allow update: if signedIn()
        && isOpen()
        && (
          (changedKeys().hasOnly(['participants']) && selfRosterWrite())
          || (changedKeys().hasOnly(['currentRound']) && selfVoteWrite())
          || (isDealer() && changedKeys().hasOnly(['currentRound', 'roundHistory']) && dealerWrite())
          || (isDealer() && (passButton() || closeTable()))
        );

      allow delete: if false;
    }

    // Where hands are played (country / region / city). Written only by the Cloudflare Worker's
    // service account, which bypasses these rules; no visitor can read or write them.
    match /hands/{hand} {
      allow read, write: if false;
    }

    // Site-wide "hands dealt" counter. It can only go up by one, in the same batch as a
    // real reveal by that table's dealer, so it can't be pumped without playing hands.
    match /stats/global {
      function isRevealBy(sessionId) {
        let before = get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        let after = getAfter(/databases/$(database)/documents/sessions/$(sessionId)).data;
        return before.dealerId == request.auth.uid
          && before.currentRound.status == 'voting'
          && after.currentRound.status == 'revealed';
      }

      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['handsDealt', 'lastSession'])
        && request.resource.data.lastSession is string
        && request.resource.data.handsDealt == (resource == null ? 0 : resource.data.handsDealt) + 1
        && isRevealBy(request.resource.data.lastSession);

      allow delete: if false;
    }
  }
}
