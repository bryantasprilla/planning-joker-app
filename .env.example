# Copy to .env.local and fill in from Firebase Console -> Project settings -> Your apps -> Web app.
# These values are public by design; Firestore security rules are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulators instead of a real project (see README).
# VITE_USE_EMULATORS=true
